<Window x:Class="DesktopTodo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DesktopTodo"
        WindowStyle="None" AllowsTransparency="True"
        ShowInTaskbar="False" Closing="Window_Closing"
        ResizeMode="CanResizeWithGrip" Background="Transparent"
        Width="380" Height="500" MinWidth="260" MinHeight="200"
        Left="50" Top="50">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6"
                      GlassFrameThickness="0" CornerRadius="12"
                      NonClientFrameEdges="None" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <local:PrioToColorConverter x:Key="PrioToColor"/>
        <ControlTemplate x:Key="ScrollPage" TargetType="RepeatButton">
            <Border Background="Transparent"/>
        </ControlTemplate>
        <ControlTemplate x:Key="TaskScrollBar" TargetType="ScrollBar">
            <Grid Background="Transparent" Margin="0,4,2,4">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand" Focusable="False" Template="{StaticResource ScrollPage}"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                        <Thumb MinHeight="20">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Grid Background="Transparent">
                                        <Border x:Name="Pill" Width="4" CornerRadius="3" Opacity=".55"
                                                Background="{DynamicResource MutedInk}"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Pill" Property="Width" Value="6"/>
                                            <Setter TargetName="Pill" Property="Opacity" Value=".85"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Accent}"/>
                                            <Setter TargetName="Pill" Property="Opacity" Value="1"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand" Focusable="False" Template="{StaticResource ScrollPage}"/>
                    </Track.IncreaseRepeatButton>
                </Track>
            </Grid>
        </ControlTemplate>
        <Style x:Key="TaskCheck" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Background="Transparent">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="23"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border x:Name="Ring" Width="18" Height="18" CornerRadius="8"
                                    BorderBrush="{DynamicResource MutedInk}" BorderThickness="1" VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Hidden" HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Data="M1,4 L4,7 L10,1" Stroke="{DynamicResource OnAccent}" StrokeThickness="1.8"
                                      StrokeLineJoin="Round" StrokeEndLineCap="Round" StrokeStartLineCap="Round"/>
                            </Border>
                            <ContentPresenter Grid.Column="1" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ring" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource MutedInk}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Width" Value="25"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonFace" Background="{TemplateBinding Background}"
                                CornerRadius="9" BorderThickness="1" BorderBrush="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="ButtonFace" Property="BorderBrush" Value="{DynamicResource TextColor}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonFace" Property="Opacity" Value="0.76"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="CardBorder" CornerRadius="12" BorderThickness="1" TextElement.FontFamily="{DynamicResource BodyFont}"
            Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource BorderColor}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Title Bar：7 列，与 7 个标题栏元素一一对应 -->
            <StackPanel Background="{DynamicResource TitleBg}" MouseLeftButtonDown="TitleBar_Drag">
            <Grid Margin="10,5,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TitleLabel" Text="Desktop Todo" Foreground="{DynamicResource MutedInk}"
                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Margin="4,0" Grid.Column="0" ToolTip="右键切换主题"
                           MouseRightButtonUp="TitleLabel_RightClick"/>
                <!-- 只有检测到新版本时才显示；自动检测不会弹窗 -->
                <Button x:Name="UpdateBtn" Content="⬆" Grid.Column="1"
                        Foreground="{DynamicResource Accent}"
                        FontWeight="Bold" Visibility="Collapsed"
                        Click="UpdateBtn_Click" ToolTip="发现新版本，点击更新"/>
                <Button x:Name="PinBtn" Content="▣" Grid.Column="2"
                        Click="PinBtn_Click" ToolTip="窗口位置：桌面小工具"/>
                <Button x:Name="FilterBtn" Content="☐" Grid.Column="3"
                        Click="FilterBtn_Click" ToolTip="显示已完成"/>
                <Button Content="⚙" Grid.Column="4"
                        Click="SettingsBtn_Click" ToolTip="设置"/>
                <Button Content="─" Grid.Column="5"
                        Click="MinBtn_Click" ToolTip="最小化到托盘"/>
                <Button Content="×" Grid.Column="6"
                        Click="CloseBtn_Click" ToolTip="隐藏到托盘（不退出）"/>
            </Grid>
            <DockPanel Margin="14,4,14,9" MouseRightButtonUp="TitleLabel_RightClick">
                <Border DockPanel.Dock="Left" Width="4" Margin="0,4,8,3" Background="{DynamicResource Accent}" CornerRadius="2"/>
                <Button x:Name="SkinButton" DockPanel.Dock="Right" Width="34" Height="28"
                        Margin="8,0,0,0" Foreground="{DynamicResource OnAccent}" Background="{DynamicResource Accent}"
                        ToolTip="选择皮肤" Click="SkinButton_Click">
                    <Path Width="19" Height="18" Stretch="Uniform"
                          Stroke="{DynamicResource OnAccent}" StrokeThickness="1.65" StrokeLineJoin="Round"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 8,3 C 9,6.6 15,6.6 16,3 L 21.5,5.8 Q 22.3,6.2 22,7 L 20.4,11 Q 20.1,11.7 19.4,11.4 L 17.6,10.7 L 17.6,19 Q 17.6,20.3 16.3,20.3 L 7.7,20.3 Q 6.4,20.3 6.4,19 L 6.4,10.7 L 4.6,11.4 Q 3.9,11.7 3.6,11 L 2,7 Q 1.7,6.2 2.5,5.8 Z"/>
                </Button>
                <TextBlock DockPanel.Dock="Right" VerticalAlignment="Bottom" Margin="4,0,0,2"
                           Foreground="{DynamicResource MutedInk}" FontSize="12"
                           Text="{Binding ElementName=TaskList, Path=Items.Count, StringFormat=当前 {0} 项}"/>
                <TextBlock Text="待办事项" Foreground="{DynamicResource TextColor}" FontSize="21"
                           FontFamily="{DynamicResource HeadingFont}" FontWeight="SemiBold"/>
            </DockPanel>
            </StackPanel>

            <!-- Task List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="Transparent">
                <ScrollViewer.Template>
                    <ControlTemplate TargetType="ScrollViewer">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"/>
                            <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Width="14" Focusable="False"
                                       Orientation="Vertical" Template="{StaticResource TaskScrollBar}"
                                       Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}"
                                       Value="{Binding VerticalOffset, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"/>
                        </Grid>
                    </ControlTemplate>
                </ScrollViewer.Template>
                <ItemsControl x:Name="TaskList" Margin="10,8,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderBrush="{DynamicResource BorderColor}" BorderThickness="{DynamicResource RowEdge}"
                                    CornerRadius="{DynamicResource RowCorners}" Margin="{DynamicResource RowMargin}"
                                    Padding="10,5" Background="{DynamicResource RowBg}"
                                    MouseRightButtonUp="TaskRow_RightClick">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="5" Height="5"
                                             VerticalAlignment="Center" Margin="0,0,6,0"
                                             Fill="{Binding Priority, Converter={StaticResource PrioToColor}}"/>
                                    <!-- 用 Click 而非 Checked/Unchecked：绑定初始化时不会反向写回服务器 -->
                                    <CheckBox Grid.Column="1" VerticalAlignment="Center" Style="{StaticResource TaskCheck}"
                                              IsChecked="{Binding Completed}"
                                              Foreground="{DynamicResource TextColor}"
                                              AutomationProperties.Name="{Binding Summary}" Click="TaskCheckChanged">
                                        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Margin="3,0,2,0"
                                                   FontFamily="{DynamicResource BodyFont}" FontSize="14">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Completed}" Value="True">
                                                            <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                            <Setter Property="Foreground" Value="{DynamicResource MutedInk}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </CheckBox>
                                    <Button Grid.Column="2" Content="✎"
                                            Width="24" Height="22" Margin="2,0"
                                            Click="EditBtn_Click" ToolTip="编辑"/>
                                    <Button Grid.Column="3" Content="×"
                                            Width="24" Height="22"
                                            Click="DelBtn_Click" ToolTip="删除"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <TextBlock Grid.Row="1" Text="暂无可显示的任务" IsHitTestVisible="False"
                       Foreground="{DynamicResource MutedInk}" HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=TaskList, Path=HasItems}" Value="False">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Input Row -->
            <Border Grid.Row="2" Margin="10,5,10,0" CornerRadius="{DynamicResource RowCorners}"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" Background="{DynamicResource InputBg}">
                <Grid Margin="5,3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="InputBox" Grid.Column="0"
                             FontFamily="{DynamicResource BodyFont}" FontSize="14"
                             Padding="5,3" Background="Transparent" VerticalContentAlignment="Center"
                             Foreground="{DynamicResource TextColor}"
                             CaretBrush="{DynamicResource TextColor}" AutomationProperties.Name="新任务" BorderThickness="0"
                             KeyDown="InputBox_KeyDown"/>
                    <TextBlock Grid.Column="0" Text="输入新任务…" VerticalAlignment="Center" Margin="7,0,0,0" FontSize="14"
                               IsHitTestVisible="False" Foreground="{DynamicResource MutedInk}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ElementName=InputBox, Path=Text}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Button Grid.Column="1" Content="添加" ToolTip="添加任务（Enter）" Width="48" Height="27"
                            FontFamily="{DynamicResource BodyFont}"
                            Margin="6,0,0,0"
                            Background="{DynamicResource Accent}" Foreground="{DynamicResource OnAccent}"
                            FontSize="12" FontWeight="SemiBold"
                            Click="AddBtn_Click"/>
                </Grid>
            </Border>

            <!-- Status Bar -->
            <TextBlock x:Name="StatusLabel" Grid.Row="3"
                       Foreground="{DynamicResource MutedInk}" FontSize="11" Padding="13,5,13,7"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
